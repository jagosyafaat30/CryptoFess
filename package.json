{
  "name": "cryptofess",
  "version": "1.0.0",
  "description": "Platform Pesan Anonim Berbasis Kriptografi (Diffie-Hellman & ElGamal)",
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:crypto": "node --test tests/math.test.js tests/diffieHellman.test.js tests/elgamal.test.js tests/encoding.test.js",
    "test:backend": "node --test tests/api.test.js tests/security.test.js",
    "start": "node backend/src/server.js",
    "dev:backend": "node --watch backend/src/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {}
}
